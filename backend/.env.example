NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Frontend
CORS_ORIGIN=http://localhost:5173

# Blockchain local de desarrollo
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
LICENSE_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# SOLO desarrollo local. NO compartir claves reales.
ISSUER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

VOUCHER_TTL_DAYS=7
GATEWAY_WEBHOOK_SECRET=dev-secret
CONTENT_URL_TTL_SECONDS=300
FX_PEN_TO_USDC=0.27

# Almacenamiento
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_API_URL=http://localhost:4000
MAX_UPLOAD_BYTES=8589934592

# Si posteriormente usan Cloudflare R2 / S3
S3_BUCKET=sauce
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Coste de bcrypt. 12 en produccion; 4 solo en pruebas.
BCRYPT_ROUNDS=12

# Base local SOLO para tests. Nunca apuntar a Supabase: la suite crea y borra datos.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sauce_test
